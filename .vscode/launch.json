{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python Debugger: Current File with Args",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "laion/clip-vit-b-32-laion2b-s34b-b79k",
        "--text-encoder",
        "D:/olive/examples/clip/qdq/models/laion/clip_b32/text/model.onnx",
        "--image-encoder",
        "D:/olive/examples/clip/qdq/models/laion/clip_b32/image/model.onnx",
        "--dataset",
        "nlphuji/flickr_1k_test_image_text_retrieval"
      ],
      "env": {
        "PYTHONPATH": "D:/NPU/NPU-Examples"
      }
    },
    {
      "name": "Python Debugger: Current Module",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
      "args": ["--inference"],
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Local ORT: Current File",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "program": "${file}",
      "cwd": "${workspaceFolder}/models/llm/deepseek/",
      "console": "integratedTerminal",
      "args": [
        "-m",
        "D:/Models/DeepSeek-R1-Distilled-NPU-Optimized",
        "-e",
        "qnn",
        "--chat_template",
        "<|begin▁of▁sentence|>You are a helpful assistant.<|User|>{input}<|Assistant|>"
      ],
      "env": {
        "PATH": "D:/ort/build/qnn/Release/Release;%PATH%",
        "PYTHONPATH": "D:/onnxruntime-genai/build/Windows/Release/wheel/build/lib.win-arm64-cpython-312;D:/ort/build/qnn/Release/Release"
      }
    },
    {
      "name": "Olive",
      "type": "debugpy",
      "request": "launch",
      "module": "olive.workflows.run",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--config",
        "./google_vit_b16_qdq.json",
        "--package-config",
        "./olive_config.json"
      ],
      "cwd": "${workspaceFolder}/models/vit/",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Olive: DeepSeek",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "module": "olive.workflows.run",
      "args": ["--config", "deepseek_r1_distill_qwen_1.5b_surgery.json"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/models/llm/deepseek/",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/models/llm/deepseek/"
      }
    },
    {
      "name": "Quant",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "program": "${workspaceFolder}/models/llm/deepseek/",
      "cwd": "${workspaceFolder}/models/llm/deepseek/",
      "args": ["--quantize-qdq", "--skip-prefill", "--skip-pre-process"],
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Eval with Olive",
      "type": "debugpy",
      "request": "launch",
      "justMyCode": false,
      "program": "${workspaceFolder}/utils/olive_eval.py",
      "cwd": "${workspaceFolder}/models/clip/qdq/",
      "args": [
        "--target",
        "npu",
        "--config",
        "./openai_clip_text_b32_qdq.json",
        "--evaluator",
        "sanity_check"
      ],
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}

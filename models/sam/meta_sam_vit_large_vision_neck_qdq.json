{
  "input_model": {
    "type": "PytorchModel",
    "model_path": "facebook/sam-vit-large",
    "io_config": {
      "input_names": ["hidden_states"],
      "input_types": ["float32"],
      "input_shapes": [[1, 64, 64, 1024]],
      "output_names": ["out_states"],
      "output_types": ["float32"],
      "dynamic_axes": {
        "hidden_states": {
          "0": "batch_size",
          "1": "patch_count",
          "2": "patch_count",
          "3": "image_size"
        }
      }
    },
    "model_loader": "load_vision_neck",
    "model_script": "meta_sam_vit_large_qdq.py",
    "script_dir": "."
  },
  "engine": {
    "host": "host_system",
    "target": "target_system",
    "clean_cache": false,
    "clean_evaluation_cache": false,
    "evaluate_input_model": false,
    "cache_dir": ".olive_cache",
    "output_dir": "outputs/meta/sam-vit-large"
  },
  "systems": {
    "host_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "cpu", "execution_providers": ["CPUExecutionProvider"] }
      ]
    },
    "target_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "npu", "execution_providers": ["QNNExecutionProvider"] }
      ]
    }
  },

  "passes": {
    "conversion": {
      "device": "cpu",
      "type": "OnnxConversion",
      "target_opset": 17,
      "dynamic": true,
      "use_dynamo_exporter": false,
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "to_fixed_shape": {
      "type": "DynamicToFixedShape",
      "input_name": ["hidden_states"],
      "input_shape": [[1, 64, 64, 1024]],
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "quantization": {
      "type": "OnnxStaticQuantization",
      "quant_preprocess": true,
      "activation_type": "QUInt16",
      "weight_type": "QUInt8",
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    }
  }
}

{
  "workflow_id": "meta_sam_vit_large_prompt_qdq",
  "input_model": {
    "type": "PytorchModel",
    "model_path": "facebook/sam-vit-large",
    "io_config": {
      "input_names": ["input_points", "input_labels", "input_boxes"],
      "input_shapes": [
        [1, 3, 32, 2],
        [1, 3, 32],
        [1, 3, 4]
      ],
      "input_types": ["float32", "int32", "float32"],
      "output_names": ["sparse_embeddings", "dense_embeddings"],
      "output_types": ["float32", "float32"],
      "dynamic_axes": {
        "input_points": {
          "0": "batch_size",
          "1": "point_batch_size",
          "2": "nb_points_per_image"
        },
        "input_labels": {
          "0": "batch_size",
          "1": "point_batch_size",
          "2": "nb_points_per_image"
        },
        "input_boxes": {
          "0": "batch_size",
          "1": "point_batch_size"
        },
        "sparse_embeddings": {
          "0": "batch_size"
        },
        "dense_embeddings": {
          "0": "batch_size"
        }
      }
    },
    "model_loader": "load_prompt_encoder",
    "model_script": "meta_sam_vit_large_qdq.py",
    "script_dir": "."
  },
  "engine": {
    "host": "host_system",
    "target": "target_system",
    "clean_cache": false,
    "clean_evaluation_cache": true,
    "evaluate_input_model": false,
    "cache_dir": ".olive_cache",
    "output_dir": "outputs/meta/sam-vit-large/prompt"
  },
  "systems": {
    "host_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "cpu", "execution_providers": ["CPUExecutionProvider"] }
      ]
    },
    "target_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "npu", "execution_providers": ["QNNExecutionProvider"] }
      ]
    }
  },

  "passes": {
    "conversion": {
      "device": "cpu",
      "type": "OnnxConversion",
      "target_opset": 17,
      "dynamic": true,
      "use_dynamo_exporter": false,
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "to_fixed_shape": {
      "type": "DynamicToFixedShape",
      "dim_param": ["batch_size", "point_batch_size", "nb_points_per_image"],
      "dim_value": [1, 3, 32],
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "quantization": {
      "type": "OnnxStaticQuantization",
      "quant_preprocess": true,
      "activation_type": "QUInt16",
      "weight_type": "QUInt8",
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    }
  }
}

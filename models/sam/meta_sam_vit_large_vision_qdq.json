{
  "workflow_id": "meta_sam_vit_large_vision_qdq",
  "input_model": {
    "type": "PytorchModel",
    "model_path": "facebook/sam-vit-large",
    "io_config": {
      "input_names": ["pixel_values"],
      "input_types": ["float32"],
      "input_shapes": [[1, 3, 1024, 1024]],
      "output_names": ["last_hidden_state"],
      "output_types": ["float32"],
      "dynamic_axes": {
        "pixel_values": {
          "0": "batch_size",
          "1": "input_channels",
          "2": "image_size",
          "3": "image_size"
        },
        "last_hidden_state": {
          "0": "batch_size",
          "2": "patch_count",
          "3": "patch_count"
        }
      }
    },
    "model_loader": "load_vision_encoder",
    "model_script": "meta_sam_vit_large_qdq.py",
    "script_dir": "."
  },
  "engine": {
    "host": "host_system",
    "target": "target_system",
    "clean_cache": false,
    "clean_evaluation_cache": false,
    "evaluate_input_model": false,
    "cache_dir": ".olive_cache",
    "output_dir": "outputs/meta/sam-vit-large/vision"
  },
  "systems": {
    "host_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "cpu", "execution_providers": ["CPUExecutionProvider"] }
      ]
    },
    "target_system": {
      "type": "LocalSystem",
      "accelerators": [
        { "device": "npu", "execution_providers": ["QNNExecutionProvider"] }
      ]
    }
  },
  "data_configs": [
    {
      "name": "calibration_data",
      "type": "HuggingfaceContainer",
      "load_dataset_config": {
        "data_name": "timm/mini-imagenet",
        "split": "train[:1]"
      },
      "pre_process_data_config": {
        "type": "process_dataset",
        "model_name": "facebook/sam-vit-large",
        "task": "image-classification",
        "input_cols": ["image"],
        "label_col": "label"
      },
      "dataloader_config": { "batch_size": 1 },
      "user_script": "meta_sam_vit_large_qdq.py",
      "script_dir": "."
    }
  ],
  "passes": {
    "conversion": {
      "device": "cpu",
      "type": "OnnxConversion",
      "target_opset": 17,
      "dynamic": true,
      "use_dynamo_exporter": false,
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "to_fixed_shape": {
      "type": "DynamicToFixedShape",
      "dim_param": [
        "batch_size",
        "input_channels",
        "image_size",
        "patch_count",
        "output_channels"
      ],
      "dim_value": [1, 3, 1024, 64, 256],
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "qnn_preprocess": {
      "type": "QNNPreprocess",
      "fuse_layernorm": true,
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    },
    "quantization": {
      "type": "OnnxStaticQuantization",
      "quant_preprocess": true,
      "data_config": "calibration_data",
      "activation_type": "QUInt16",
      "weight_type": "QUInt8",
      "save_as_external_data": true,
      "all_tensors_to_one_file": true
    }
  }
}

{
  "input_model": {
    "type": "HfModel",
    "model_path": "microsoft/resnet-101",
    "task": "image-classification",
    "generative": false,
    "io_config": {
      "input_names": ["pixel_values"],
      "input_shapes": [[1, 3, 224, 224]],
      "output_names": ["logits"],
      "dynamic_axes": {
        "pixel_values": { "0": "batch_size" },
        "logits": { "0": "batch_size" }
      }
    }
  },
  "passes": {
    "conversion": {
      "type": "OnnxConversion",
      "target_opset": 20,
      "dynamic": true,
      "use_dynamo_exporter": false
    },
    "to_fixed_shape": {
      "type": "DynamicToFixedShape",
      "dim_param": ["batch_size"],
      "dim_value": [1]
    },

    "quantization": {
      "type": "OnnxStaticQuantization",
      "data_config": "calib_data",
      "quant_preprocess": true,
      "activation_type": "uint16",
      "precision": "uint8"
    }
  },
  "data_configs": [
    {
      "name": "calib_data",
      "type": "HuggingfaceContainer",
      "load_dataset_config": {
        "data_name": "timm/mini-imagenet",
        "split": "validation[:12]"
      },
      "pre_process_data_config": {
        "type": "image_pre_process",
        "input_col": "image",
        "label_col": "label"
      },
      "dataloader_config": { "batch_size": 1 },
      "user_script": "imagenet_script.py"
    },
    {
      "name": "eval_data",
      "type": "HuggingfaceContainer",
      "load_dataset_config": {
        "data_name": "timm/mini-imagenet",
        "split": "test"
      },
      "pre_process_data_config": {
        "type": "image_pre_process",
        "input_col": "image",
        "label_col": "label"
      },
      "post_process_data_config": { "type": "image_post_process" },
      "dataloader_config": { "batch_size": 1 },
      "user_script": "imagenet_script.py"
    }
  ],
  "evaluators": {
    "cls_mini_imagenet": {
      "metrics": [
        {
          "name": "top1",
          "type": "custom",
          "data_config": "eval_data",
          "sub_types": [
            { "name": "accuracy", "priority": 1, "higher_is_better": true },
            { "name": "f1", "higher_is_better": true }
          ],
          "user_config": {
            "metric_func": "eval_accu_and_f1",
            "metric_func_kwargs": { "average": "macro" },
            "user_script": "imagenet_script.py"
          }
        },
        {
          "name": "latency",
          "type": "latency",
          "sub_types": [{ "name": "avg" }]
        }
      ]
    },
    "performance": {
      "metrics": [
        {
          "name": "latency",
          "type": "latency",
          "sub_types": [
            {
              "name": "avg",
              "priority": 1,
              "metric_config": { "warmup_num": 20, "repeat_test_num": 100 }
            },
            {
              "name": "p90",
              "metric_config": { "warmup_num": 20, "repeat_test_num": 100 }
            }
          ]
        }
      ]
    }
  },
  "clean_cache": true,
  "clean_evaluation_cache": true,
  "evaluate_input_model": false,
  "output_dir": "models/microsoft/resnet_101"
}
